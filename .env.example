# Copy to .env and adjust (optional — docker-compose.yml has sensible defaults)
# cp .env.example .env

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true
API_PREFIX=/api/v1
API_PORT=8000

# --- PostgreSQL (postgres service) ---
POSTGRES_USER=si
POSTGRES_PASSWORD=si
POSTGRES_DB=store_intelligence
POSTGRES_PORT=5432

# Async SQLAlchemy URL (host must be "postgres" inside Docker network)
DATABASE_URL=postgresql+asyncpg://si:si@postgres:5432/store_intelligence

# --- Startup ---
# Seed demo tenant + store on first boot (idempotent)
SEED_DEMO_DATA=true
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_INTERVAL_SECONDS=2

# --- Observability ---
HEALTH_STALE_FEED_MINUTES=15

# --- API server ---
UVICORN_WORKERS=1

# --- API authentication (required in Docker Compose default) ---
API_KEY=purple-demo-key
API_KEY_REQUIRED=true
REVIEWER_MODE=true
REVIEWER_API_BASE_URL=http://localhost:8000

# --- Metrics projector (runs after successful ingest) ---
METRICS_PROJECTOR_ENABLED=true
METRICS_PROJECTOR_HOURS_BACK=24

# --- Pipeline worker (auto YOLO ingest on docker compose up) ---
PIPELINE_MODE=yolo
PIPELINE_MAX_FRAMES=40
# JWT_SECRET=change-me-in-production
